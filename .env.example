# ============ Database ============
# Matches docker-compose.yml (run `npm run db:up` first).
# Uses the root user locally because Prisma Migrate needs CREATE DATABASE
# privileges for its shadow database; use a least-privilege user in production.
DATABASE_URL="mysql://root:root@localhost:3307/test_mela"

# ============ Backend (NestJS) ============
PORT=4100
NODE_ENV=development

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Razorpay (leave blank in dev; payments will not verify without real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notification transport: "console" logs OTP/emails to the server console (dev default).
# Swap to "smtp" and fill the SMTP_* vars to send real email.
NOTIFICATION_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Test Mela <no-reply@testmela.com>"

# ============ Frontend (student app) ============
NEXT_PUBLIC_API_URL=http://localhost:4100/api

# ============ Admin app ============
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4100/api
